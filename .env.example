# Configuración del Proxy Backend Seguro (Astro Serverless -> Google Sheets)
# NUNCA exponer estas variables con el prefijo PUBLIC_

# Opción A: Conexión mediante Google Service Account (API v4 directa)
GOOGLE_SHEETS_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Opción B: Conexión mediante Webhook privado de Google Apps Script (Proxy oculto en servidor)
APPS_SCRIPT_WEBHOOK_URL=""

# Configuración pública del sitio (SEO y Dominio)
PUBLIC_SITE_URL="https://wigooshop.ec"
PUBLIC_STORE_NAME="WIGGER SHOP 2"
PUBLIC_WHATSAPP_NUMBER="593992576986"

