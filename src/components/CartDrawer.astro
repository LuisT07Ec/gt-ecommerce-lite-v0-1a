---
import Icon from './Icon.astro';
---

<div
  id="cartDrawerBackdrop"
  data-action="close-cart-drawer"
  class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 transition-opacity opacity-0 pointer-events-none duration-300"
  aria-hidden="true"
></div>

<aside
  id="cartDrawer"
  aria-label="Resumen rápido del carrito"
  class="fixed top-0 right-0 h-full w-full sm:w-[420px] bg-[#0D0E12] border-l border-white/10 z-50 flex flex-col transform translate-x-full transition-transform duration-300 ease-out shadow-2xl"
>
  <!-- Drawer Header -->
  <div class="p-4 sm:p-5 border-b border-white/10 flex items-center justify-between bg-[#12141A]">
    <div class="flex items-center gap-2.5">
      <button
        type="button"
        data-action="close-cart-drawer"
        aria-label="Volver al catálogo"
        class="flex items-center gap-2 text-slate-300 hover:text-white transition-colors group"
      >
        <Icon name="arrow_back" class="w-5 h-5 group-hover:-translate-x-1 transition-transform" />
        <span class="font-bold text-base text-white">Mi Carrito</span>
      </button>
      <span
        id="drawerCartBadge"
        class="px-2 py-0.5 rounded-full bg-[#FF5722]/20 text-[#FF5722] text-[11px] font-extrabold border border-[#FF5722]/30"
      >
        0 items
      </span>
    </div>

    <div class="flex items-center gap-2">
      <a
        href="/carrito"
        class="text-xs font-bold text-[#FF5722] hover:underline px-2 py-1"
      >
        Ver pantalla completa
      </a>
      <button
        type="button"
        data-action="close-cart-drawer"
        aria-label="Cerrar carrito lateral"
        class="w-8 h-8 rounded-full bg-white/5 hover:bg-white/10 flex items-center justify-center text-slate-400 hover:text-white transition-colors"
      >
        <Icon name="close" class="w-4 h-4" />
      </button>
    </div>
  </div>

  <!-- Items List Body -->
  <div id="cartDrawerItemsList" class="flex-1 overflow-y-auto p-4 sm:p-5 space-y-3.5">
    <!-- Renderizado reactivo desde store.ts -->
  </div>

  <!-- Drawer Footer -->
  <div class="p-5 border-t border-white/10 bg-[#12141A] space-y-3.5">
    <div class="flex items-center justify-between text-xs text-slate-400">
      <span>Modalidad de Entrega:</span>
      <span id="drawerDeliveryLabel" class="font-bold text-emerald-400">PASO RETIRAR ($0.00)</span>
    </div>
    <div class="flex items-center justify-between">
      <span class="text-sm font-medium text-slate-300">Subtotal Carrito:</span>
      <span id="drawerTotalPrice" class="text-2xl font-black text-white">$0.00</span>
    </div>

    <div class="grid grid-cols-2 gap-2.5">
      <a
        href="/carrito"
        class="py-3 px-3 rounded-xl bg-white/10 hover:bg-white/15 text-white font-bold text-xs flex items-center justify-center gap-1.5 border border-white/10 transition-all"
      >
        <Icon name="shopping_cart" class="w-4 h-4" />
        <span>Ir al Carrito</span>
      </a>
      <button
        type="button"
        data-action="open-order-modal"
        class="py-3 px-3 rounded-xl bg-[#FF5722] hover:bg-[#e0420f] active:scale-[0.98] text-white font-black text-xs tracking-wide shadow-lg shadow-orange-950/60 flex items-center justify-center gap-1.5 transition-all"
      >
        <span>Confirmar Pedido</span>
        <Icon name="arrow_forward" class="w-4 h-4" />
      </button>
    </div>

    <p class="text-[11px] text-center text-slate-400 flex items-center justify-center gap-1.5">
      <Icon name="lock" class="w-3.5 h-3.5 text-emerald-400" />
      <span>Confirmación directa y segura por WhatsApp</span>
    </p>
  </div>
</aside>

