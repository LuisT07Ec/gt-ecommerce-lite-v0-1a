---
import Icon from './Icon.astro';
---

<dialog
  id="orderConfirmDialog"
  closedby="closerequest"
  aria-labelledby="orderModalTitle"
  class="w-full max-w-xl bg-transparent p-0 m-auto rounded-3xl text-slate-100 open:flex open:flex-col backdrop:bg-black/80 backdrop:backdrop-blur-md"
>
  <section class="relative w-full liquid-glass-l2 rounded-3xl overflow-hidden flex flex-col max-h-[92vh]">
    <!-- Top Glowing Orange Line -->
    <div class="h-1 w-full bg-gradient-to-r from-transparent via-[#FF5722] to-transparent"></div>

    <!-- Header Section -->
    <header class="px-6 sm:px-8 pt-5 pb-4 flex items-center justify-between border-b border-white/10 bg-[#12141A]/95">
      <div>
        <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#FF5722] flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[#FF5722] animate-pulse"></span>
          <span id="orderModalModeBadge">Checkout Directo • WIGGER SHOP 2</span>
        </span>
        <h2 id="orderModalTitle" class="text-xl sm:text-2xl font-black tracking-tight text-white mt-0.5">
          Confirmar Pedido
        </h2>
      </div>
      <button
        type="button"
        id="closeOrderModalBtn"
        aria-label="Cerrar formulario de confirmación"
        class="w-9 h-9 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-slate-400 hover:text-white hover:bg-white/10 transition-colors"
      >
        <Icon name="close" class="w-4 h-4" />
      </button>
    </header>

    <div class="overflow-y-auto px-6 sm:px-8 py-5 space-y-4">
      <!-- Compact Cart Summary Banner -->
      <div class="p-4 rounded-2xl bg-white/[0.04] border border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-[#181a22] border border-white/10 flex items-center justify-center text-[#FF5722]">
            <Icon name="shopping_bag" class="w-5 h-5" />
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span id="modalOrderItemsCount" class="text-xs font-bold text-white">0 productos seleccionados</span>
              <span id="modalOrderTimeBadge" class="text-[10px] px-2 py-0.5 rounded-full bg-[#FF5722]/15 text-[#FF5722] border border-[#FF5722]/30 font-bold">
                15 min
              </span>
            </div>
            <p id="modalOrderBreakdownText" class="text-[11px] text-slate-400 mt-0.5">
              Subtotal: $0.00 + Envío: $0.00
            </p>
          </div>
        </div>
        <div class="flex sm:flex-col items-center sm:items-end justify-between border-t sm:border-t-0 pt-2 sm:pt-0 border-white/10">
          <span class="text-[11px] text-slate-400 font-medium">Total a pagar:</span>
          <span id="modalOrderTotalAmount" class="text-xl font-black text-[#FF5722] tracking-tight leading-none mt-0.5">
            $0.00
          </span>
        </div>
      </div>

      <!-- Alert Box for Form Feedback -->
      <div
        id="orderFormAlert"
        role="alert"
        class="hidden p-3 rounded-xl bg-rose-500/15 border border-rose-500/30 text-xs font-semibold text-rose-200"
      ></div>

      <!-- Main Order Form (100% WCAG Explicit Labels) -->
      <form id="orderConfirmForm" class="space-y-3.5" novalidate>
        <!-- Field 1: Nombre y Apellidos -->
        <div class="space-y-1">
          <div class="flex items-center justify-between">
            <label for="orderCustomerName" class="block text-xs font-bold uppercase tracking-wider text-white">
              Nombre y Apellidos <span class="text-[#FF5722]">*</span>
            </label>
            <span class="text-[10px] text-slate-400">Máx. 50 caracteres (solo letras)</span>
          </div>
          <div class="relative">
            <input
              id="orderCustomerName"
              name="nombre_entrega"
              type="text"
              required
              maxlength="50"
              autocomplete="name"
              placeholder="Ej: Juan Pérez"
              oninput="this.value = this.value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s]/g, '').slice(0, 50)"
              class="w-full bg-[#181a22] border border-white/10 rounded-xl pl-3.5 pr-10 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-[#FF5722] focus:ring-1 focus:ring-[#FF5722] transition-all"
            />
            <span class="absolute right-3.5 top-2.5 text-slate-400 pointer-events-none">
              <Icon name="person" class="w-4 h-4" />
            </span>
          </div>
          <p id="errorCustomerName" class="text-[11px] text-rose-400 font-medium hidden error-feedback"></p>
        </div>

        <!-- Row: Cédula/RUC & Teléfono -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          <!-- Field 2: Cédula / RUC (Documento) -->
          <div class="space-y-1">
            <div class="flex items-center justify-between">
              <label for="orderCustomerDoc" class="block text-xs font-bold uppercase tracking-wider text-white">
                Cédula / RUC <span class="text-[#FF5722]">*</span>
              </label>
              <span class="text-[10px] text-slate-400">10 o 13 dígitos</span>
            </div>
            <div class="relative">
              <input
                id="orderCustomerDoc"
                name="rut_entrega"
                type="text"
                inputmode="numeric"
                required
                maxlength="13"
                placeholder="10 dígitos o RUC (...001)"
                oninput="this.value = this.value.replace(/\D/g, '').slice(0, 13)"
                class="w-full bg-[#181a22] border border-white/10 rounded-xl pl-3.5 pr-10 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-[#FF5722] focus:ring-1 focus:ring-[#FF5722] transition-all"
              />
              <span class="absolute right-3.5 top-2.5 text-slate-400 pointer-events-none">
                <Icon name="badge" class="w-4 h-4" />
              </span>
            </div>
            <p id="errorCustomerDoc" class="text-[11px] text-rose-400 font-medium hidden error-feedback"></p>
          </div>

          <!-- Field 3: Teléfono WhatsApp -->
          <div class="space-y-1">
            <div class="flex items-center justify-between">
              <label for="orderCustomerPhone" class="block text-xs font-bold uppercase tracking-wider text-white">
                Teléfono WhatsApp <span class="text-[#FF5722]">*</span>
              </label>
              <span class="text-[10px] text-slate-400">10 dígitos</span>
            </div>
            <div id="phoneInputContainer" class="flex rounded-xl overflow-hidden bg-[#181a22] border border-white/10 focus-within:border-[#FF5722] focus-within:ring-1 focus-within:ring-[#FF5722] transition-all">
              <span class="inline-flex items-center gap-1 px-2.5 bg-white/5 border-r border-white/10 text-xs font-bold text-slate-300 select-none">
                <span>🇪🇨</span>
                <span>+593</span>
              </span>
              <input
                id="orderCustomerPhone"
                name="telefono_entrega"
                type="tel"
                inputmode="numeric"
                pattern="[0-9]*"
                maxlength="10"
                required
                autocomplete="tel"
                placeholder="0990000000"
                oninput="this.value = this.value.replace(/\D/g, '').slice(0, 10)"
                class="w-full bg-transparent text-white text-sm px-3 py-2.5 placeholder-slate-500 focus:outline-none"
              />
            </div>
            <p id="errorCustomerPhone" class="text-[11px] text-rose-400 font-medium hidden error-feedback"></p>
          </div>
        </div>

        <!-- Field 4: Correo Electrónico -->
        <div class="space-y-1">
          <div class="flex items-center justify-between">
            <label for="orderCustomerEmail" class="block text-xs font-bold uppercase tracking-wider text-white">
              Correo Electrónico <span class="text-[#FF5722]">*</span>
            </label>
            <span class="text-[10px] text-slate-400">ejemplo@correo.com</span>
          </div>
          <div class="relative">
            <input
              id="orderCustomerEmail"
              name="correo_entrega"
              type="email"
              required
              maxlength="50"
              autocomplete="email"
              placeholder="cliente@ejemplo.com"
              oninput="this.value = this.value.replace(/[\/\*\[\]{}()\s]/g, '').slice(0, 50)"
              class="w-full bg-[#181a22] border border-white/10 rounded-xl pl-3.5 pr-10 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-[#FF5722] focus:ring-1 focus:ring-[#FF5722] transition-all"
            />
            <span class="absolute right-3.5 top-2.5 text-slate-400 pointer-events-none">
              <Icon name="alternate_email" class="w-4 h-4" />
            </span>
          </div>
          <p id="errorCustomerEmail" class="text-[11px] text-rose-400 font-medium hidden error-feedback"></p>
        </div>

        <!-- Field 5: Dirección de Entrega -->
        <div class="space-y-1">
          <div class="flex items-center justify-between">
            <label for="orderCustomerAddress" class="block text-xs font-bold uppercase tracking-wider text-white">
              Dirección de Entrega <span class="text-[#FF5722]">*</span>
            </label>
            <span class="text-[10px] text-slate-400">Máx. 100 caracteres (letras, núm. y guion -)</span>
          </div>
          <div class="relative">
            <input
              id="orderCustomerAddress"
              name="direccion_entrega"
              type="text"
              required
              maxlength="100"
              autocomplete="street-address"
              placeholder="Calle principal, número de casa/edificio y referencia"
              oninput="this.value = this.value.replace(/[^a-zA-Z0-9áéíóúÁÉÍÓÚñÑüÜ\s\-]/g, '').slice(0, 100)"
              class="w-full bg-[#181a22] border border-white/10 rounded-xl pl-3.5 pr-10 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-[#FF5722] focus:ring-1 focus:ring-[#FF5722] transition-all"
            />
            <span class="absolute right-3.5 top-2.5 text-slate-400 pointer-events-none">
              <Icon name="location_on" class="w-4 h-4" />
            </span>
          </div>
          <p id="errorCustomerAddress" class="text-[11px] text-rose-400 font-medium hidden error-feedback"></p>
        </div>

        <!-- Row: Agencia de Envío & Forma de Pago -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          <!-- Field 6: Agencia / Forma de Entrega -->
          <div class="space-y-1">
            <label for="orderCustomerShipping" class="block text-xs font-bold uppercase tracking-wider text-white">
              Agencia / Entrega <span class="text-[#FF5722]">*</span>
            </label>
            <div class="relative">
              <select
                id="orderCustomerShipping"
                name="agencia_entrega"
                required
                class="w-full bg-[#181a22] border border-white/10 rounded-xl pl-3.5 pr-9 py-2.5 text-xs sm:text-sm text-white focus:outline-none focus:border-[#FF5722] focus:ring-1 focus:ring-[#FF5722] transition-all appearance-none cursor-pointer"
              >
                <option value="PASO RETIRAR">PASO RETIRAR ($0.00 • 15 min)</option>
                <option value="ENVÍO A DOMICILIO">ENVÍO A DOMICILIO ($1.50 • 35 min)</option>
              </select>
              <span class="absolute right-3 top-3 text-slate-400 pointer-events-none">
                <Icon name="expand_more" class="w-4 h-4" />
              </span>
            </div>
          </div>

          <!-- Field 7: Forma de Pago -->
          <div class="space-y-1">
            <label for="orderCustomerPayment" class="block text-xs font-bold uppercase tracking-wider text-white">
              Forma de Pago <span class="text-[#FF5722]">*</span>
            </label>
            <div class="relative">
              <select
                id="orderCustomerPayment"
                name="forma_pago"
                required
                class="w-full bg-[#181a22] border border-white/10 rounded-xl pl-3.5 pr-9 py-2.5 text-xs sm:text-sm text-white focus:outline-none focus:border-[#FF5722] focus:ring-1 focus:ring-[#FF5722] transition-all appearance-none cursor-pointer"
              >
                <option value="Efectivo">Efectivo</option>
                <option value="Transferencia">Transferencia</option>
                <option value="Tarjeta de crédito">Tarjeta de crédito</option>
              </select>
              <span class="absolute right-3 top-3 text-slate-400 pointer-events-none">
                <Icon name="expand_more" class="w-4 h-4" />
              </span>
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="pt-2 space-y-2.5">
          <button
            type="submit"
            id="submitOrderBtn"
            class="w-full py-3.5 px-6 rounded-xl bg-[#25D366] hover:bg-[#1ea952] active:scale-[0.99] text-white font-extrabold text-sm tracking-wide shadow-xl shadow-green-950/60 transition-all flex items-center justify-center gap-2.5 cursor-pointer"
          >
            <Icon name="whatsapp" class="w-5 h-5" />
            <span id="submitOrderBtnText">Confirmar Pedido y Enviar a WhatsApp</span>
            <Icon name="arrow_forward" class="w-4 h-4" />
          </button>

          <div class="flex items-center justify-center gap-2 text-center">
            <Icon name="lock" class="w-3.5 h-3.5 text-emerald-400 shrink-0" />
            <p class="text-[11px] text-slate-400">
              Registra tu orden con código único y abre el WhatsApp de la tienda.
            </p>
          </div>
        </div>
      </form>
    </div>
  </section>
</dialog>

