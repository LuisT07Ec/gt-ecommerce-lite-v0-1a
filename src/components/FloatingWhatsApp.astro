---
import Icon from './Icon.astro';

interface Props {
  whatsappNumber?: string;
}

const { whatsappNumber = '593992576986' } = Astro.props;
const defaultText = encodeURIComponent(
  'Hola WIGGER SHOP 2 (Wigoo Shop EC), deseo realizar una consulta sobre su catálogo.'
);
---

<a
  href={`https://wa.me/${whatsappNumber}?text=${defaultText}`}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contactar por WhatsApp al 593992576986"
  class="fixed bottom-20 md:bottom-6 right-4 sm:right-6 z-40 w-14 h-14 rounded-full bg-[#25D366] hover:bg-[#1ea952] text-white flex items-center justify-center shadow-[0_0_25px_rgba(37,211,102,0.45)] hover:scale-110 active:scale-95 transition-all"
>
  <Icon name="whatsapp" class="w-8 h-8" />
</a>

