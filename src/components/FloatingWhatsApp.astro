---
import Icon from './Icon.astro';

interface Props {
  whatsappNumber?: string;
}

const { whatsappNumber = '' } = Astro.props;
const defaultText = encodeURIComponent(
  'Hola, deseo realizar una consulta sobre el catálogo de la tienda.'
);
const cleanPhone = String(whatsappNumber || '').replace(/\D/g, '');
const href = cleanPhone
  ? `https://wa.me/${cleanPhone}?text=${defaultText}`
  : '#';
---

<a
  href={href}
  target={cleanPhone ? '_blank' : '_self'}
  rel={cleanPhone ? 'noopener noreferrer' : undefined}
  aria-label="Contactar a la tienda por WhatsApp"
  class="fixed bottom-20 md:bottom-6 right-4 sm:right-6 z-40 w-14 h-14 rounded-full bg-[#25D366] hover:bg-[#1ea952] text-white flex items-center justify-center shadow-[0_0_25px_rgba(37,211,102,0.45)] hover:scale-110 active:scale-95 transition-all"
>
  <Icon name="whatsapp" class="w-8 h-8" />
</a>
