---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import BottomNav from '../components/BottomNav.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import CartDrawer from '../components/CartDrawer.astro';
import ProductDetailModal from '../components/ProductDetailModal.astro';
import OrderConfirmModal from '../components/OrderConfirmModal.astro';
import Icon from '../components/Icon.astro';
import {
  listarConfiguracion,
  formatomonto,
  type CategoriaCatalogo,
  type ProductoCatalogo,
} from '../lib/sheets-service';

const configData = listarConfiguracion();
const storeName = String(configData.pagina_nombre || 'WIGGER SHOP 2');
const whatsappNumber = String(configData.contactabilidad || '593992576986');
const categories = (configData.content || []) as CategoriaCatalogo[];
const banners = (configData.pagina_carrusel || [
  '/fotos/banner-mayorista-1.svg',
  '/fotos/banner-ofertas-2.svg',
  '/fotos/banner-envios-3.svg',
]) as string[];

const allProducts: ProductoCatalogo[] = [];
for (const cat of categories) {
  for (const prod of cat.producto) {
    allProducts.push(prod);
  }
}
---

<BaseLayout
  title={`${storeName} | Wigoo Shop EC — Catálogo Liquid Glass y Pedidos WhatsApp`}
  description="Catálogo mayorista y minorista de peluches Disney, ofertas, juguetes infantiles y ropa en Ecuador. Paso a retirar $0.00 o envío a domicilio $1.50."
>
  <Header activePage="catalogo" whatsappNumber={whatsappNumber} storeName={storeName} />

  <!-- ================= STICKY CATEGORIES PILL SLIDER ================= -->
  <div class="border-b border-white/5 bg-[#0D0E12]/90 backdrop-blur-md sticky top-[90px] z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-2.5 flex items-center gap-2">
      <button
        type="button"
        id="catScrollPrev"
        aria-label="Categorías anteriores"
        class="hidden sm:flex w-8 h-8 rounded-full bg-white/5 border border-white/10 hover:bg-[#FF5722] hover:border-[#FF5722] text-slate-300 hover:text-white items-center justify-center shrink-0 transition-colors"
      >
        <Icon name="chevron_left" class="w-4 h-4" />
      </button>

      <div
        id="categoryScroller"
        role="tablist"
        aria-label="Filtrar por categoría"
        class="flex items-center gap-2 overflow-x-auto hide-scrollbar scroll-smooth flex-1 py-1"
      >
        <button
          type="button"
          role="tab"
          aria-selected="true"
          data-category-filter="TODOS"
          class="category-pill px-4 py-2 rounded-xl text-xs font-bold bg-[#FF5722] text-white shadow-md shadow-orange-950/60 flex items-center gap-1.5 shrink-0 transition-all"
        >
          <span>✨</span>
          <span>Todos ({allProducts.length})</span>
        </button>

        {categories.map((cat) => (
          <button
            type="button"
            role="tab"
            aria-selected="false"
            data-category-filter={cat.nombre}
            class="category-pill px-4 py-2 rounded-xl text-xs font-medium bg-white/5 border border-white/10 hover:bg-white/10 hover:text-white text-slate-300 flex items-center gap-1.5 shrink-0 transition-all"
          >
            <span>{cat.icono}</span>
            <span>{cat.nombre}</span>
            <span class="text-[10px] opacity-75">({cat.producto.length})</span>
          </button>
        ))}
      </div>

      <button
        type="button"
        id="catScrollNext"
        aria-label="Siguientes categorías"
        class="hidden sm:flex w-8 h-8 rounded-full bg-white/5 border border-white/10 hover:bg-[#FF5722] hover:border-[#FF5722] text-slate-300 hover:text-white items-center justify-center shrink-0 transition-colors"
      >
        <Icon name="chevron_right" class="w-4 h-4" />
      </button>
    </div>
  </div>

  <!-- ================= MAIN CATALOG CONTENT ================= -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 pt-5 pb-12 space-y-6">
    <!-- Edit Mode Notification Banner (?o=e&id=UUID) -->
    <div
      id="editModeBanner"
      class="hidden p-4 rounded-2xl bg-amber-500/15 border border-amber-500/30 text-amber-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3"
    >
      <div class="text-xs">
        <span class="font-extrabold uppercase tracking-wider text-amber-400 block">
          Modo Edición de Pedido Activo
        </span>
        <span>
          Estás modificando el pedido <strong id="editModeOrderId" class="font-mono"></strong>. Ajusta tus productos y presiona Confirmar Pedido para guardar los cambios.
        </span>
      </div>
      <button
        type="button"
        data-action="open-order-modal"
        class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-black font-extrabold text-xs shrink-0 transition-all"
      >
        Guardar Pedido Editado
      </button>
    </div>

    <!-- 1. Search Bar & Quick Delivery Filter -->
    <section aria-label="Buscador de productos" class="w-full">
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <div class="relative flex-1 flex items-center bg-[#12141A] border border-white/10 focus-within:border-[#FF5722] rounded-2xl px-4 py-2.5 shadow-lg transition-all">
          <Icon name="search" class="w-5 h-5 text-slate-400 mr-3 shrink-0" />
          <label for="catalogSearchInput" class="sr-only">
            Buscar peluches, juguetes, ropa u ofertas
          </label>
          <input
            id="catalogSearchInput"
            type="search"
            placeholder="Buscar por nombre o categoría (ej. Buzz, Minnie, Capitán, Ropa)..."
            class="w-full bg-transparent text-white placeholder:text-slate-400 text-sm focus:outline-none"
          />
          <button
            type="button"
            id="clearSearchBtn"
            aria-label="Limpiar búsqueda"
            class="hidden text-xs font-bold text-slate-400 hover:text-white px-2 py-1"
          >
            Limpiar
          </button>
        </div>

        <div class="hidden md:flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-white/[0.04] border border-white/10 text-xs text-slate-300 shrink-0">
          <Icon name="verified_user" class="w-4 h-4 text-emerald-400" />
          <span>Precios Mayoristas & Unidad • IVA Incluido</span>
        </div>
      </div>
    </section>

    <!-- 2. Hero Banner with Interactive Offer Carousel -->
    <section aria-label="Ofertas destacadas" class="w-full">
      <div class="relative overflow-hidden rounded-3xl glass-card border border-white/10 shadow-2xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 items-center">
          <!-- Left Text Overlay -->
          <div class="p-6 sm:p-8 lg:col-span-5 flex flex-col items-start gap-3 z-10">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FF5722] text-white text-[11px] font-extrabold uppercase tracking-wider shadow-sm">
              <span>Mayoristas & Detal EC</span>
              <span>🔥</span>
            </div>
            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-white tracking-tight leading-tight">
              Precios por Docena, Pack y Unidad
            </h1>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              Surtido directo de bodega para tu negocio, bazar o regalo especial. Retiro inmediato ($0.00 • 15 min) o envío a domicilio ($1.50 • 35 min).
            </p>
            <div class="flex flex-wrap items-center gap-2.5 pt-2">
              <a
                href="#catalogoGridSection"
                class="px-5 py-2.5 rounded-xl bg-[#FF5722] hover:bg-[#e0420f] text-white font-extrabold text-xs flex items-center gap-2 shadow-lg shadow-orange-950/60 transition-all active:scale-95"
              >
                <span>Explorar Catálogo</span>
                <Icon name="arrow_forward" class="w-4 h-4" />
              </a>
              <a
                href="/carrito"
                class="px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-bold text-xs border border-white/10 transition-all"
              >
                Ver Mi Pedido
              </a>
            </div>
          </div>

          <!-- Right Visual Carousel Slides (LCP Optimized per Modern Web Guidance) -->
          <div class="lg:col-span-7 relative w-full h-48 sm:h-64 lg:h-72 overflow-hidden bg-[#0D0E13]">
            {banners.map((bannerUrl, index) => (
              <div
                data-carousel-slide={index}
                class:list={[
                  'carousel-slide absolute inset-0 transition-opacity duration-500',
                  index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none',
                ]}
              >
                {index === 0 ? (
                  <img
                    src={bannerUrl}
                    alt={`${storeName} Banner Principal Oferta ${index + 1}`}
                    width="1200"
                    height="420"
                    fetchpriority="high"
                    class="w-full h-full object-cover"
                  />
                ) : (
                  <img
                    src={bannerUrl}
                    alt={`${storeName} Banner Promocional ${index + 1}`}
                    width="1200"
                    height="420"
                    fetchpriority="low"
                    loading="lazy"
                    class="w-full h-full object-cover"
                  />
                )}
              </div>
            ))}

            <!-- Carousel Indicators -->
            <div class="absolute bottom-3 right-4 z-20 flex items-center gap-1.5 bg-black/50 backdrop-blur-md px-2.5 py-1.5 rounded-full border border-white/10">
              {banners.map((_, index) => (
                <button
                  type="button"
                  data-carousel-dot={index}
                  aria-label={`Ir al banner ${index + 1}`}
                  class:list={[
                    'h-2 rounded-full transition-all',
                    index === 0 ? 'w-6 bg-[#FF5722]' : 'w-2 bg-white/40 hover:bg-white/70',
                  ]}
                />
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Section Header -->
    <div id="catalogoGridSection" class="flex items-center justify-between pt-2 pb-2 border-b border-white/10">
      <div>
        <h2 id="activeCategoryHeading" class="text-xl sm:text-2xl font-black text-white tracking-tight flex items-center gap-2">
          Todos los Productos
        </h2>
        <p class="text-xs text-slate-400 mt-0.5">
          Selecciona un producto para elegir variedades, tallas/colores y cantidad mínima
        </p>
      </div>
      <div class="flex items-center gap-2">
        <span
          id="visibleProductsCounter"
          class="text-xs font-bold px-3 py-1 rounded-full bg-white/10 text-slate-200 border border-white/10"
        >
          {allProducts.length} productos
        </span>
      </div>
    </div>

    <!-- 4. Responsive Product Grid (2 cols mobile, 3 tablet, 4 desktop) -->
    <section
      id="productCatalogGrid"
      aria-label="Listado de productos del catálogo"
      class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-5"
    >
      {allProducts.map((prod) => {
        const defaultVar = prod.variedad[0];
        const minQty = defaultVar?.minima || 1;
        const hasMultipleVars = prod.variedad.length > 1;
        return (
          <article
            data-product-card={prod.codigo}
            data-product-name={prod.nombre.toLowerCase()}
            data-product-category={prod.categoria}
            class="glass-card rounded-2xl p-3 sm:p-3.5 flex flex-col justify-between group cursor-pointer"
            data-action="open-product-modal"
            data-product-code={prod.codigo}
          >
            <div>
              <!-- Image Container -->
              <div class="relative w-full aspect-square rounded-xl overflow-hidden bg-[#0D0E13] flex items-center justify-center p-2 mb-3 border border-white/5">
                <img
                  src={prod.imagen}
                  alt={prod.nombre}
                  width="300"
                  height="300"
                  loading="lazy"
                  class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                />

                <!-- Category / Popular Badge -->
                <span class="absolute top-2 left-2 px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider bg-[#FF5722] text-white shadow-sm">
                  {prod.badge || prod.categoria}
                </span>

                <!-- Dynamic In-Cart Badge -->
                <span
                  data-in-cart-pill
                  class="hidden absolute top-2 right-2 px-2 py-0.5 rounded-md text-[10px] font-extrabold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 backdrop-blur-md"
                >
                  En Carrito ✓
                </span>

                <!-- Minimum Quantity & Varieties Micro-Pill -->
                <div class="absolute bottom-2 inset-x-2 flex items-center justify-between gap-1 pointer-events-none">
                  <span class="px-2 py-0.5 rounded bg-black/75 backdrop-blur-sm text-[10px] font-semibold text-slate-200 border border-white/10 truncate">
                    {defaultVar.variedad}
                  </span>
                  {hasMultipleVars && (
                    <span class="px-1.5 py-0.5 rounded bg-[#FF5722]/25 text-[#ffb5a0] text-[9px] font-extrabold border border-[#FF5722]/40 shrink-0">
                      +{prod.variedad.length} opciones
                    </span>
                  )}
                </div>
              </div>

              <!-- Product Title & Info -->
              <div class="space-y-0.5">
                <span class="text-[10px] font-bold uppercase tracking-wider text-[#FF5722]">
                  {prod.categoria} • Mín: {minQty} u.
                </span>
                <h3 class="text-sm sm:text-base font-bold text-white line-clamp-1 group-hover:text-[#FF5722] transition-colors">
                  {prod.nombre}
                </h3>
                <p class="text-[11px] text-slate-400 line-clamp-1">
                  {defaultVar.sub_variedad || prod.descripcion}
                </p>
              </div>
            </div>

            <!-- Price & Action Row -->
            <div class="mt-3 pt-2.5 border-t border-white/5 flex items-end justify-between gap-2">
              <div>
                {prod.pvp_original && (
                  <span class="text-[11px] text-slate-400 line-through block leading-none">
                    ${formatomonto(prod.pvp_original)}
                  </span>
                )}
                <div class="text-lg sm:text-xl font-black text-white leading-tight mt-0.5">
                  ${formatomonto(defaultVar.precio)}
                </div>
              </div>

              <button
                type="button"
                aria-label={`Ver variedades y agregar ${prod.nombre}`}
                data-action="quick-add-product"
                data-product-code={prod.codigo}
                class="px-3 py-2 rounded-xl bg-[#FF5722] hover:bg-[#e0420f] active:scale-95 text-white font-bold text-xs flex items-center gap-1.5 shadow-md shadow-orange-950/50 transition-all"
              >
                <Icon name="add_shopping_cart" class="w-4 h-4" />
                <span>Elegir</span>
              </button>
            </div>
          </article>
        );
      })}
    </section>

    <!-- Empty Filter Result Message -->
    <div
      id="emptyFilterMessage"
      class="hidden py-12 text-center glass-card rounded-3xl p-8 max-w-md mx-auto space-y-3"
    >
      <p class="text-base font-extrabold text-white">No encontramos productos con ese filtro</p>
      <p class="text-xs text-slate-400">
        Intenta con otra palabra clave o selecciona la categoría "Todos".
      </p>
      <button
        type="button"
        id="resetCatalogFilterBtn"
        class="px-5 py-2.5 rounded-xl bg-[#FF5722] text-white text-xs font-bold"
      >
        Mostrar Todos los Productos
      </button>
    </div>

    <!-- 5. Trust Badges Section -->
    <section aria-label="Garantías de la tienda" class="w-full pt-4">
      <div class="liquid-glass rounded-2xl p-4 sm:p-6 shadow-lg">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
          <div class="flex flex-col items-center justify-center gap-1.5 p-2">
            <div class="w-11 h-11 rounded-full bg-white/5 border border-white/10 text-[#FF5722] flex items-center justify-center">
              <Icon name="local_shipping" class="w-5 h-5" />
            </div>
            <span class="text-xs sm:text-sm text-white font-bold">Entrega Transparente</span>
            <span class="text-[11px] text-slate-400">
              Paso a Retirar $0.00 (15m) | Envío a Domicilio $1.50 (35m)
            </span>
          </div>

          <div class="flex flex-col items-center justify-center gap-1.5 p-2">
            <div class="w-11 h-11 rounded-full bg-white/5 border border-white/10 text-emerald-400 flex items-center justify-center">
              <Icon name="verified_user" class="w-5 h-5" />
            </div>
            <span class="text-xs sm:text-sm text-white font-bold">Múltiples Formas de Pago</span>
            <span class="text-[11px] text-slate-400">
              Efectivo, Transferencia Bancaria y Tarjeta de Crédito
            </span>
          </div>

          <div class="flex flex-col items-center justify-center gap-1.5 p-2">
            <div class="w-11 h-11 rounded-full bg-white/5 border border-white/10 text-amber-400 flex items-center justify-center">
              <Icon name="support_agent" class="w-5 h-5" />
            </div>
            <span class="text-xs sm:text-sm text-white font-bold">Atención Directa WhatsApp</span>
            <span class="text-[11px] text-slate-400">
              Soporte personalizado al +{whatsappNumber}
            </span>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Shared Overlays & Modals -->
  <CartDrawer />
  <ProductDetailModal />
  <OrderConfirmModal />
  <FloatingWhatsApp whatsappNumber={whatsappNumber} />
  <BottomNav activePage="catalogo" whatsappNumber={whatsappNumber} />

  <!-- Serialized Catalog Data for Astro Island Hydration -->
  <script
    id="wigooCatalogData"
    type="application/json"
    set:html={JSON.stringify(categories)}
  />

  <script>
    import { initStorefront } from '../scripts/store';

    const rawCatalog = document.getElementById('wigooCatalogData')?.textContent || '[]';
    const categories = JSON.parse(rawCatalog);
    initStorefront(categories);

    // Category filter & search bar logic
    let currentCategory = 'TODOS';
    let currentQuery = '';

    const searchInput = document.getElementById('catalogSearchInput') as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById('clearSearchBtn');
    const headingEl = document.getElementById('activeCategoryHeading');
    const counterEl = document.getElementById('visibleProductsCounter');
    const emptyMsgEl = document.getElementById('emptyFilterMessage');
    const productCards = Array.from(
      document.querySelectorAll<HTMLElement>('[data-product-card]')
    );
    const categoryPills = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-category-filter]')
    );

    function applyCatalogFilters() {
      let visibleCount = 0;
      const q = currentQuery.trim().toLowerCase();

      for (const card of productCards) {
        const name = card.dataset.productName || '';
        const cat = card.dataset.productCategory || '';
        const matchesCat = currentCategory === 'TODOS' || cat === currentCategory;
        const matchesQuery = !q || name.includes(q) || cat.toLowerCase().includes(q);

        if (matchesCat && matchesQuery) {
          card.classList.remove('hidden');
          visibleCount += 1;
        } else {
          card.classList.add('hidden');
        }
      }

      if (headingEl) {
        headingEl.textContent =
          currentCategory === 'TODOS'
            ? 'Todos los Productos'
            : `Categoría: ${currentCategory}`;
      }
      if (counterEl) {
        counterEl.textContent = `${visibleCount} producto${visibleCount === 1 ? '' : 's'}`;
      }
      if (emptyMsgEl) {
        emptyMsgEl.classList.toggle('hidden', visibleCount > 0);
      }
      if (clearSearchBtn) {
        clearSearchBtn.classList.toggle('hidden', !q);
      }
    }

    categoryPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        currentCategory = pill.dataset.categoryFilter || 'TODOS';
        categoryPills.forEach((p) => {
          const active = p.dataset.categoryFilter === currentCategory;
          p.setAttribute('aria-selected', active ? 'true' : 'false');
          p.className = active
            ? 'category-pill px-4 py-2 rounded-xl text-xs font-bold bg-[#FF5722] text-white shadow-md shadow-orange-950/60 flex items-center gap-1.5 shrink-0 transition-all'
            : 'category-pill px-4 py-2 rounded-xl text-xs font-medium bg-white/5 border border-white/10 hover:bg-white/10 hover:text-white text-slate-300 flex items-center gap-1.5 shrink-0 transition-all';
        });
        applyCatalogFilters();
      });
    });

    searchInput?.addEventListener('input', () => {
      currentQuery = searchInput.value;
      applyCatalogFilters();
    });

    clearSearchBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      currentQuery = '';
      applyCatalogFilters();
    });

    document.getElementById('resetCatalogFilterBtn')?.addEventListener('click', () => {
      currentCategory = 'TODOS';
      currentQuery = '';
      if (searchInput) searchInput.value = '';
      categoryPills[0]?.click();
    });

    // Category horizontal scroll buttons
    const scroller = document.getElementById('categoryScroller');
    document.getElementById('catScrollPrev')?.addEventListener('click', () => {
      scroller?.scrollBy({ left: -220, behavior: 'smooth' });
    });
    document.getElementById('catScrollNext')?.addEventListener('click', () => {
      scroller?.scrollBy({ left: 220, behavior: 'smooth' });
    });

    // Hero Carousel Auto-Rotation & Dots
    const slides = Array.from(document.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));
    let activeSlide = 0;

    function showSlide(index: number) {
      if (slides.length === 0) return;
      activeSlide = (index + slides.length) % slides.length;
      slides.forEach((s, idx) => {
        const isCurrent = idx === activeSlide;
        s.classList.toggle('opacity-100', isCurrent);
        s.classList.toggle('z-10', isCurrent);
        s.classList.toggle('opacity-0', !isCurrent);
        s.classList.toggle('z-0', !isCurrent);
        s.classList.toggle('pointer-events-none', !isCurrent);
      });
      dots.forEach((d, idx) => {
        d.className =
          idx === activeSlide
            ? 'h-2 w-6 rounded-full bg-[#FF5722] transition-all'
            : 'h-2 w-2 rounded-full bg-white/40 hover:bg-white/70 transition-all';
      });
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        showSlide(Number(dot.dataset.carouselDot) || 0);
      });
    });

    if (slides.length > 1) {
      setInterval(() => {
        showSlide(activeSlide + 1);
      }, 5500);
    }
  </script>
</BaseLayout>

